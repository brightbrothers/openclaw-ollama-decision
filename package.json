{
  "name": "openclaw-ollama-decision",
  "version": "0.2.1",
  "type": "module",
  "description": "Local AI classification and decisions for OpenClaw via Ollama: Tev1 0.8B and 4B; Boolean, Choice and Score.",
  "engines": {
    "node": ">=22"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.10.4"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node smoke.js"
  },
  "files": [
    "index.js",
    "provider.js",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "smoke.js",
    "docs/demo.md",
    "LICENSE",
    "docs/example.md",
    "assets/icon.png",
    "assets/demo.gif",
    "docs/openclaw-demo.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brightbrothers/openclaw-ollama-decision.git"
  },
  "homepage": "https://github.com/brightbrothers/openclaw-ollama-decision#readme",
  "bugs": {
    "url": "https://github.com/brightbrothers/openclaw-ollama-decision/issues"
  },
  "keywords": [
    "openclaw",
    "ollama",
    "tev1",
    "decision-models",
    "systemone",
    "local-inference",
    "incident-triage"
  ]
}
